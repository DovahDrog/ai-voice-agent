  "$id": "https://example.invalid/schemas/voice-tools.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Standalone protected voice-agent tool backend. Demo/log-only by default; no streaming speech engine. Provider adapters require explicit user configuration and caller permission.",
  "title": "AI Voice Agent Tool Backend Contracts",
  "tools": {
    "check_calendar": {
      "method": "POST",
      "path": "/tools/check_calendar",
      "request": {
        "$ref": "#/$defs/CalendarRequest"
      },
      "response": {
        "$ref": "#/$defs/CalendarResponse"
      }
    },
    "create_prospect": {
      "method": "POST",
      "path": "/tools/create_prospect",
      "request": {
        "$ref": "#/$defs/CreateProspectRequest"
      },
      "response": {
