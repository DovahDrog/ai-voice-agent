# Safe local defaults. This file is a reference; the app does not auto-load it.
# Generate a fresh secret with secrets.token_urlsafe(32), never commit its value.
VOICE_TOOLS_SHARED_SECRET=
VOICE_CALL_LOG_DIR=runtime
VOICE_BOOKING_URL=https://example.invalid/book
VOICE_ALLOWED_LINK_HOSTS=example.com,example.invalid
VOICE_TOOLS_BASE_URL=https://voice.example.invalid

# All external delivery stays off unless an operator explicitly changes each gate.
VOICE_DEMO_MODE=true
VOICE_SMS_DELIVERY_ENABLED=false
VOICE_EMAIL_DELIVERY_ENABLED=false
VOICE_SMS_PROVIDER=
VOICE_EMAIL_PROVIDER=
VOICE_GHL_API_TOKEN=
VOICE_GHL_LOCATION_ID=
VOICE_GHL_API_BASE_URL=
VOICE_GHL_ALLOWED_API_HOSTS=
VOICE_GHL_API_VERSION=2021-07-28
